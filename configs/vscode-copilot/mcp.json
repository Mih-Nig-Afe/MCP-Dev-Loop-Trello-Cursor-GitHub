{
  "servers": {
    "trello": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/dist/trello-mcp.cjs"],
      "env": {
        "TRELLO_API_KEY": "${env:TRELLO_API_KEY}",
        "TRELLO_TOKEN": "${env:TRELLO_TOKEN}",
        "TRELLO_BOARD_ID": "${env:TRELLO_BOARD_ID}"
      }
    }
  }
}
